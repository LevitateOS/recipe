const RECIPE_API = 1;
const NEEDS = #{ outputs: #{ payload: "file" }, network: [@ENDPOINT@] };
fn build(src, out) {
    let source = join_path(WORK, "checkout");
    git_checkout(@URL@, source, @COMMIT@);
    git_checkout(@URL@, source, @COMMIT@);
    if trim(exec_output("git", ["-C", source, "rev-parse", "HEAD"])) != @COMMIT@ { throw "wrong Git revision"; }
    verify_sha256(join_path(source, @PAYLOAD@), @DIGEST@);
    copy_file(join_path(source, @PAYLOAD@), out);
}
