const RECIPE_API = 1;
const NEEDS = #{ outputs: #{ program: "file", rootfs: "directory", packages: "directory" }, network: ["dl-cdn.alpinelinux.org:443"], network_max_bytes: 16777216 };
fn build(src, out) {
    let packages = join_path(WORK, "packages");
    mkdir(packages);
    for row in @ROWS@ { download(row[2], join_path(packages, basename(row[2])), row[3]); }
    let tool = join_path(WORK, "tool");
    extract_with_format(join_path(packages, @TOOLNAME@), tool, "apk");
    let program = join_path(tool, "sbin/apk.static");
    let uid = trim(exec_output("id", ["-u"], #{uid: 1000, gid: 1000}));
    let gid = trim(exec_output("id", ["-g"], #{uid: 1000, gid: 1000}));
    if uid != "1000" || gid != "1000" { throw "wrong package-tool identity"; }
    if !exec_output(program, ["--version"], #{uid: 1000, gid: 1000}).contains("apk-tools 3.0.9-r0") { throw "wrong APK version"; }
    let root = out.rootfs;
    mkdir(join_path(root, "etc/apk/keys"));
    write_file(join_path(root, "etc/apk/keys/" + @KEYNAME@), @KEY@);
    let cache = join_path(WORK, "apk-cache");
    mkdir(cache);
    let args = ["--root", root, "--usermode", "--initdb", "--no-progress", "--no-scripts", "--force-non-repository", "--no-network", "--cache-dir", cache, "add"];
    for name in @PACKAGES@ { args.push(join_path(packages, name)); }
    exec_checked(program, args, #{uid: 1000, gid: 1000});
    target_capture_apks(root, [packages, cache]);
    let echoed = exec_output(join_path(root, "lib/ld-musl-x86_64.so.1"), [join_path(root, "bin/busybox"), "echo", "installed APK executed"], #{uid: 1000, gid: 1000});
    if echoed != "installed APK executed\n" { throw "installed APK did not execute"; }
    copy_file(program, out.program);
    copy_tree_contents(packages, out.packages);
}
